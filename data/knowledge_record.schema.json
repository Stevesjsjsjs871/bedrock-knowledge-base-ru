{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Метаданные доказательности технического утверждения Bedrock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "claim",
    "evidence",
    "sources",
    "limitations"
  ],
  "properties": {
    "document": {
      "type": "string",
      "minLength": 1,
      "description": "Путь к документу относительно корня репозитория."
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "Одно конкретное утверждение, статус которого проверяется."
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "game_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation",
        "source_code",
        "in_game"
      ],
      "properties": {
        "documentation": {
          "enum": [
            "not_checked",
            "confirmed",
            "contradicted",
            "not_applicable"
          ]
        },
        "source_code": {
          "enum": [
            "not_checked",
            "inspected",
            "contradicted",
            "not_applicable"
          ]
        },
        "in_game": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "tested_versions",
            "platform",
            "tested_on"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_tested",
                "passed",
                "failed",
                "partial",
                "not_applicable"
              ]
            },
            "tested_versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "platform": {
              "type": [
                "string",
                "null"
              ]
            },
            "tested_on": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "failed",
                      "partial"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "tested_versions": {
                    "minItems": 1
                  },
                  "platform": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tested_on": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "checked_on"
        ],
        "properties": {
          "kind": {
            "enum": [
              "official_docs",
              "upstream_code",
              "community",
              "experiment"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "checked_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
